{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: all app commands",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:event:default",
    "core:window:allow-set-fullscreen",
    "notification:default",
    "global-shortcut:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/printezy247/EzyView/*"
        }
      ]
    },
    "allow-open-chart-window",
    "allow-api-key-get",
    "allow-api-key-set",
    "allow-clear-keyring-secrets",
    "allow-save-file",
    "allow-write-snapshot",
    "allow-append-log",
    "allow-read-log",
    "allow-clear-log",
    "allow-get-shell-settings",
    "allow-set-shell-settings",
    "allow-relaunch-app",
    "allow-factory-reset"
  ]
}

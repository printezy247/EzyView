{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EzyView",
  "version": "0.3.2",
  "identifier": "com.printezy247.ezyview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && npm run build -w @ezyview/mcp-server",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EzyView",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://data-api.binance.vision https://api.binance.com https://api.kraken.com https://api.twelvedata.com wss://ws.twelvedata.com wss://stream.binance.vision wss://ws.kraken.com https://finnhub.io https://www.alphavantage.co https://api.github.com http://127.0.0.1:8765 http://127.0.0.1:22346",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://data-api.binance.vision https://api.binance.com https://api.kraken.com https://api.twelvedata.com wss://ws.twelvedata.com wss://stream.binance.vision wss://ws.kraken.com https://finnhub.io https://www.alphavantage.co https://api.github.com http://127.0.0.1:8765 http://127.0.0.1:22346 http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Finance",
    "shortDescription": "Open-source trading terminal",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "printezy247 <printezy247@users.noreply.github.com>",
    "homepage": "https://github.com/printezy247/EzyView",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 printezy247",
    "longDescription": "EzyView is an open-source, TradingView-class trading terminal.\nIt provides charts, 50+ indicators, drawing tools, a Pine Script editor,\npaper trading, MetaTrader 5 integration, a trading journal, fundamentals,\na screener, options analytics and an MCP server for AI assistants.",
    "resources": {
      "../../../packages/mcp-server/dist/ezyview-mcp.mjs": "mcp/ezyview-mcp.mjs",
      "../../../tools/mt5-bridge/bridge.py": "mt5-bridge/bridge.py",
      "../../../tools/mt5-bridge/README.md": "mt5-bridge/README.md"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "depends": [
          "libc6 (>= 2.39)"
        ],
        "recommends": [
          "nodejs",
          "gnome-keyring"
        ],
        "desktopTemplate": "../../../packaging/EzyView.desktop.hbs",
        "files": {
          "/usr/share/doc/ezy-view/copyright": "../../../packaging/copyright",
          "/usr/share/doc/ezy-view/changelog.gz": "../../../packaging/changelog.gz",
          "/usr/share/doc/ezy-view/LICENSE": "../../../LICENSE",
          "/usr/share/doc/ezy-view/NOTICE": "../../../NOTICE",
          "/usr/share/man/man1/ezyview.1.gz": "../../../packaging/ezyview.1.gz",
          "/usr/share/man/man1/ezyview-mcp.1.gz": "../../../packaging/ezyview-mcp.1.gz",
          "/usr/share/man/man1/ezyview-mt5-bridge.1.gz": "../../../packaging/ezyview-mt5-bridge.1.gz",
          "/usr/share/metainfo/com.printezy247.ezyview.metainfo.xml": "../../../packaging/com.printezy247.ezyview.metainfo.xml",
          "/usr/share/doc/ezy-view/mt5-bridge.md": "../../../tools/mt5-bridge/README.md",
          "/usr/bin/ezyview-mt5-bridge": "../../../packaging/ezyview-mt5-bridge",
          "/usr/bin/ezyview-mcp": "../../../packaging/ezyview-mcp"
        }
      }
    }
  }
}

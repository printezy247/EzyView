{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EzyView",
  "version": "0.1.0",
  "identifier": "com.printezy247.ezyview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && npm run build -w @ezyview/mcp-server",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EzyView",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Finance",
    "shortDescription": "Open-source trading terminal",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "printezy247",
    "homepage": "https://github.com/printezy247/EzyView",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 printezy247",
    "longDescription": "EzyView is an open-source, TradingView-class trading terminal: charts, 50+ indicators, drawing tools, a Pine Script editor, paper trading, MetaTrader 5 integration, a trading journal, fundamentals, a screener, options analytics and an MCP server for AI assistants.",
    "resources": {
      "../../../packages/mcp-server/dist/ezyview-mcp.mjs": "mcp/ezyview-mcp.mjs"
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}

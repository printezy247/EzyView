{
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/.next/**", "**/target/**", "**/coverage/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off"
  }
}
